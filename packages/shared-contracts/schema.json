{
  "$defs": {
    "CGMReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "duplicates": {
          "title": "Duplicates",
          "type": "integer"
        },
        "reading_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Reading Ids",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "accepted",
        "duplicates",
        "received_at",
        "warnings",
        "reading_ids"
      ],
      "title": "CGMReceipt",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "maxLength": 128,
          "pattern": "^food\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Id",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$",
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "canonical_id",
        "label",
        "score"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "title": "Details",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details",
        "correlation_id"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "EventReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "duplicates": {
          "title": "Duplicates",
          "type": "integer"
        },
        "event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "accepted",
        "duplicates",
        "received_at",
        "warnings",
        "event_ids"
      ],
      "title": "EventReceipt",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "anchor_meal_id": {
          "format": "uuid",
          "title": "Anchor Meal Id",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "evidence_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Reasons",
          "type": "array"
        },
        "graph_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Similarity"
        },
        "nutrient_similarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Nutrient Similarity",
          "type": "number"
        },
        "response": {
          "$ref": "#/$defs/GlucoseResponse"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "source_revision_refs": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Revision Refs",
          "type": "array"
        },
        "vector_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Similarity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "episode_id",
        "anchor_meal_id",
        "source_revision_refs",
        "event_time",
        "available_at",
        "score",
        "nutrient_similarity",
        "evidence_reasons",
        "warnings",
        "response"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ForecastData": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "input_snapshot_ref": {
          "title": "Input Snapshot Ref",
          "type": "string"
        },
        "model_version_id": {
          "format": "uuid",
          "title": "Model Version Id",
          "type": "string"
        },
        "nominal_coverage": {
          "default": 0.9,
          "maximum": 0.9,
          "minimum": 0.9,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ForecastPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "prediction_id": {
          "format": "uuid",
          "title": "Prediction Id",
          "type": "string"
        },
        "source_revision_refs": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Revision Refs",
          "type": "array"
        },
        "uncertainty_method": {
          "const": "synthetic-patient-max-split-residual-v1",
          "default": "synthetic-patient-max-split-residual-v1",
          "title": "Uncertainty Method",
          "type": "string"
        }
      },
      "required": [
        "prediction_id",
        "model_version_id",
        "artifact_sha256",
        "input_snapshot_ref",
        "source_revision_refs",
        "points"
      ],
      "title": "ForecastData",
      "type": "object"
    },
    "ForecastPoint": {
      "additionalProperties": false,
      "properties": {
        "glucose_mg_dl": {
          "exclusiveMinimum": 0,
          "title": "Glucose Mg Dl",
          "type": "number"
        },
        "horizon_minutes": {
          "enum": [
            30,
            60,
            90,
            120
          ],
          "title": "Horizon Minutes",
          "type": "integer"
        },
        "lower_mg_dl": {
          "exclusiveMinimum": 0,
          "title": "Lower Mg Dl",
          "type": "number"
        },
        "target_time": {
          "format": "date-time",
          "title": "Target Time",
          "type": "string"
        },
        "upper_mg_dl": {
          "exclusiveMinimum": 0,
          "title": "Upper Mg Dl",
          "type": "number"
        }
      },
      "required": [
        "horizon_minutes",
        "target_time",
        "glucose_mg_dl",
        "lower_mg_dl",
        "upper_mg_dl"
      ],
      "title": "ForecastPoint",
      "type": "object"
    },
    "ForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "horizons_minutes": {
          "default": [
            30,
            60,
            90,
            120
          ],
          "items": {
            "enum": [
              30,
              60,
              90,
              120
            ],
            "type": "integer"
          },
          "title": "Horizons Minutes",
          "type": "array"
        },
        "input_cutoff": {
          "format": "date-time",
          "title": "Input Cutoff",
          "type": "string"
        },
        "model_profile": {
          "default": "persistence-v1",
          "enum": [
            "persistence-v1",
            "linear-v1",
            "ridge-v1"
          ],
          "title": "Model Profile",
          "type": "string"
        }
      },
      "required": [
        "input_cutoff"
      ],
      "title": "ForecastRequest",
      "type": "object"
    },
    "ForecastResult": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForecastData"
            },
            {
              "type": "null"
            }
          ]
        },
        "experimental": {
          "const": true,
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        },
        "feature_version": {
          "const": "cgm12-five-minute-age-aware-v1",
          "default": "cgm12-five-minute-age-aware-v1",
          "title": "Feature Version",
          "type": "string"
        },
        "input_cutoff": {
          "format": "date-time",
          "title": "Input Cutoff",
          "type": "string"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "title": "Missing Data",
          "type": "array"
        },
        "model_profile": {
          "enum": [
            "persistence-v1",
            "linear-v1",
            "ridge-v1"
          ],
          "title": "Model Profile",
          "type": "string"
        },
        "policy_version": {
          "const": "synthetic-research-grid5-fresh5-v2",
          "default": "synthetic-research-grid5-fresh5-v2",
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "safety_evaluation_id": {
          "format": "uuid",
          "title": "Safety Evaluation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "eligible",
            "abstained"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "input_cutoff",
        "safety_evaluation_id",
        "model_profile",
        "reason_codes",
        "assumptions",
        "missing_data",
        "warnings",
        "data"
      ],
      "title": "ForecastResult",
      "type": "object"
    },
    "GlucoseResponse": {
      "additionalProperties": false,
      "properties": {
        "first": {
          "exclusiveMinimum": 0,
          "title": "First",
          "type": "number"
        },
        "last": {
          "exclusiveMinimum": 0,
          "title": "Last",
          "type": "number"
        },
        "maximum": {
          "exclusiveMinimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "maximum_gap_minutes": {
          "minimum": 0,
          "title": "Maximum Gap Minutes",
          "type": "number"
        },
        "minimum": {
          "exclusiveMinimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "observed_span_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Span Fraction",
          "type": "number"
        },
        "samples": {
          "minimum": 2,
          "title": "Samples",
          "type": "integer"
        },
        "unit": {
          "const": "mg/dL",
          "default": "mg/dL",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "first",
        "last",
        "samples",
        "observed_span_fraction",
        "maximum_gap_minutes"
      ],
      "title": "GlucoseResponse",
      "type": "object"
    },
    "ImageQuality": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "status": {
          "enum": [
            "accepted",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "enum": [
              "COLOR_PROFILE_NOT_APPLIED",
              "RGB_CONVERTED",
              "ALPHA_COMPOSITED_WHITE"
            ],
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "width",
        "height",
        "warnings"
      ],
      "title": "ImageQuality",
      "type": "object"
    },
    "LivenessResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "alive",
          "default": "alive",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "LivenessResponse",
      "type": "object"
    },
    "MealReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "duplicates": {
          "title": "Duplicates",
          "type": "integer"
        },
        "meal_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Meal Ids",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "accepted",
        "duplicates",
        "received_at",
        "warnings",
        "meal_ids"
      ],
      "title": "MealReceipt",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "calibration_status": {
          "enum": [
            "temperature_scaled",
            "uncalibrated"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Dataset Version",
          "type": "string"
        },
        "model_id": {
          "format": "uuid",
          "title": "Model Id",
          "type": "string"
        },
        "preprocessing_version": {
          "const": "rgb-letterbox224-v1",
          "title": "Preprocessing Version",
          "type": "string"
        },
        "taxonomy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Taxonomy Version",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "version",
        "taxonomy_version",
        "preprocessing_version",
        "dataset_version",
        "calibration_status"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ReadinessResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ready",
          "default": "ready",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "ReadinessResponse",
      "type": "object"
    },
    "RebuildRequest": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "const": "research-response120-context120-v1",
          "default": "research-response120-context120-v1",
          "title": "Definition Version",
          "type": "string"
        }
      },
      "title": "RebuildRequest",
      "type": "object"
    },
    "RebuildResult": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "title": "Definition Version",
          "type": "string"
        },
        "experimental": {
          "const": true,
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        },
        "graph_status": {
          "enum": [
            "synchronized",
            "unavailable",
            "not_configured"
          ],
          "title": "Graph Status",
          "type": "string"
        },
        "index_watermark": {
          "format": "date-time",
          "title": "Index Watermark",
          "type": "string"
        },
        "inserted": {
          "minimum": 0,
          "title": "Inserted",
          "type": "integer"
        },
        "retained": {
          "minimum": 0,
          "title": "Retained",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "skipped_meals": {
          "minimum": 0,
          "title": "Skipped Meals",
          "type": "integer"
        },
        "tombstoned": {
          "minimum": 0,
          "title": "Tombstoned",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "definition_version",
        "inserted",
        "retained",
        "tombstoned",
        "skipped_meals",
        "graph_status",
        "index_watermark"
      ],
      "title": "RebuildResult",
      "type": "object"
    },
    "RetrievalRequest": {
      "additionalProperties": false,
      "properties": {
        "anchor_meal_id": {
          "format": "uuid",
          "title": "Anchor Meal Id",
          "type": "string"
        },
        "input_cutoff": {
          "format": "date-time",
          "title": "Input Cutoff",
          "type": "string"
        },
        "limit": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "retrieval_profile_version": {
          "default": "structured-v1",
          "enum": [
            "structured-v1",
            "vector-v1",
            "hybrid-v1"
          ],
          "title": "Retrieval Profile Version",
          "type": "string"
        }
      },
      "required": [
        "input_cutoff",
        "anchor_meal_id"
      ],
      "title": "RetrievalRequest",
      "type": "object"
    },
    "RetrievalResult": {
      "additionalProperties": false,
      "properties": {
        "audit_reference": {
          "format": "uuid",
          "title": "Audit Reference",
          "type": "string"
        },
        "definition_hash": {
          "title": "Definition Hash",
          "type": "string"
        },
        "definition_version": {
          "title": "Definition Version",
          "type": "string"
        },
        "degraded_mode": {
          "default": null,
          "title": "Degraded Mode",
          "type": "null"
        },
        "embedding_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Embedding Version"
        },
        "episodes": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Episodes",
          "type": "array"
        },
        "experimental": {
          "const": true,
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        },
        "index_watermark": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index Watermark"
        },
        "input_cutoff": {
          "format": "date-time",
          "title": "Input Cutoff",
          "type": "string"
        },
        "ranking_version": {
          "const": "nutrient-food-weights-v1",
          "default": "nutrient-food-weights-v1",
          "title": "Ranking Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "retrieval_id": {
          "format": "uuid",
          "title": "Retrieval Id",
          "type": "string"
        },
        "retrieval_profile_version": {
          "enum": [
            "structured-v1",
            "vector-v1",
            "hybrid-v1"
          ],
          "title": "Retrieval Profile Version",
          "type": "string"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "evidence",
            "abstained"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "retrieval_id",
        "status",
        "input_cutoff",
        "retrieval_profile_version",
        "definition_version",
        "definition_hash",
        "embedding_version",
        "index_watermark",
        "episodes",
        "reason_codes",
        "warnings",
        "audit_reference"
      ],
      "title": "RetrievalResult",
      "type": "object"
    },
    "Role": {
      "enum": [
        "researcher",
        "clinician",
        "participant",
        "administrator"
      ],
      "title": "Role",
      "type": "string"
    },
    "SessionResponse": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/Role"
          },
          "title": "Roles",
          "type": "array"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "roles",
        "expires_at"
      ],
      "title": "SessionResponse",
      "type": "object"
    },
    "VisionAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "experimental": {
          "const": true,
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "enum": [
            "MODEL_UNAVAILABLE",
            "MODEL_READY"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "supported_tasks": {
          "items": {
            "enum": [
              "single_label_classification",
              "multi_label_classification",
              "detection",
              "semantic_segmentation",
              "instance_segmentation"
            ],
            "type": "string"
          },
          "title": "Supported Tasks",
          "type": "array"
        }
      },
      "required": [
        "available",
        "supported_tasks",
        "model",
        "reason_code"
      ],
      "title": "VisionAvailability",
      "type": "object"
    },
    "VisionResult": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "maxItems": 5,
          "title": "Candidates",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "experimental": {
          "const": true,
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        },
        "image_quality": {
          "$ref": "#/$defs/ImageQuality"
        },
        "model": {
          "$ref": "#/$defs/ModelInfo"
        },
        "prediction_id": {
          "format": "uuid",
          "title": "Prediction Id",
          "type": "string"
        },
        "processing_ms": {
          "minimum": 0,
          "title": "Processing Ms",
          "type": "number"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "LOW_CONFIDENCE",
              "AMBIGUOUS_CLASS",
              "HUMAN_REVIEW_REQUIRED",
              "UNSUPPORTED_CAPABILITY"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "review_required",
            "abstained"
          ],
          "title": "Status",
          "type": "string"
        },
        "task": {
          "enum": [
            "single_label_classification",
            "multi_label_classification",
            "detection",
            "semantic_segmentation",
            "instance_segmentation"
          ],
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "prediction_id",
        "status",
        "task",
        "model",
        "image_quality",
        "candidates",
        "reason_codes",
        "processing_ms",
        "completed_at"
      ],
      "title": "VisionResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
